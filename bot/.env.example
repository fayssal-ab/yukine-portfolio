DISCORD_TOKEN=your-discord-bot-token
CLIENT_ID=your-discord-application-id
# Optional: set this to register commands instantly in a test server.
GUILD_ID=your-test-server-id
PORTFOLIO_URL=https://your-portfolio.example
# Optional staff role ID for ticket access.
STAFF_ROLE_ID=your-staff-role-id
# MySQL connection. Use the Aiven host, port, database, and username.
DB_HOST=your-mysql-host
DB_PORT=3306
DB_NAME=your-database-name
DB_USER=your-database-user
DB_PASSWORD=replace-with-your-database-password
# Provide the Aiven CA certificate path for verified TLS.
DB_SSL_CA_PATH=/absolute/path/to/ca.pem

# Required by `npm run db:reset`; must exactly match DB_NAME.
RESET_EXPECTED_DB=your-database-name
